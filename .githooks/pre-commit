#!/usr/bin/env bash
set -e

if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
    if grep -R -nP --exclude-dir={node_modules,target,backend} '//\s*TODO:' src src-tauri/src > /tmp/todos.txt; then
        sed 's/^\([^:]*:[^:]*\):/  \1\n    /' /tmp/todos.txt
        echo "❌ Pending TODOs found in code"
        exit 1
    fi
fi

exit 0
