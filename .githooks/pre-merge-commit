#!/usr/bin/env bash
set -e

if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
    todos=$(grep -R -nP --exclude-dir={node_modules,target,backend} '//\s*TODO:' src src-tauri/src || true)
    if [ -n "$todos" ]; then
        echo "$todos" | sed 's/^\([^:]*:[^:]*\):/  \1\n    /'
        echo "❌ Pending TODOs found in code"
        exit 1
    fi
fi
