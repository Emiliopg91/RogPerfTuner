{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RogPerfTuner",
  "mainBinaryName": "rog-perf-tuner",
  "version": "4.14.10",
  "identifier": "com.emiliopg91.rog-perf-tuner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RogPerfTuner",
        "width": 460,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
